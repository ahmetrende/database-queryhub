# Runtime configuration. This one file serves both installs:
#
#   container   cp .env.example .env, fill in the four values in the block at
#               the bottom, then
#                   docker compose -f docker-compose.install.yml up -d
#   systemd     copied to /etc/queryhub/env by deploy/INSTALL.md; the block at
#               the bottom stays commented out and is ignored.
#
# /etc/queryhub/env — non-secret runtime configuration.
#
# After install (see deploy/INSTALL.md) this file holds connection
# settings only; the actual secrets — SLACK_BOT_TOKEN, SLACK_APP_TOKEN,
# BOT_DB_PASSWORD — live encrypted in /etc/queryhub/secrets.enc,
# managed via:
#
#     sudo .venv/bin/python scripts/manage_env_secrets.py init
#     sudo .venv/bin/python scripts/manage_env_secrets.py set SLACK_BOT_TOKEN
#     sudo .venv/bin/python scripts/manage_env_secrets.py list
#
# Bot loads the encrypted file at startup; no need to set these here.

# Bot metadata DB (a dedicated DB on your central Postgres / RDS).
BOT_DB_HOST=dba-rds.<aws-id>.<region>.rds.amazonaws.com
BOT_DB_PORT=5432
BOT_DB_NAME=queryhub
BOT_DB_USER=queryhub

# Metadata connection-pool size. Read here rather than from bot_config,
# because reading bot_config needs this pool. The default (10) suits a single
# host serving a few dozen users; raise it if the web app's latency climbs
# while the target databases are idle — that is threads queueing for a
# metadata connection, not a slow query. Every web route is synchronous, so
# the ceiling that matters upstream is uvicorn's threadpool (40 by default).
# Invalid or out-of-range values log a warning and fall back to the default.
#QH_DB_POOL_MIN=1
#QH_DB_POOL_MAX=10

# Master encryption key for target server credentials + the encrypted
# secrets file above. Owner = the user the bot runs as (e.g. `ubuntu`),
# mode 600 (owner-rw only). crypto.py rejects any group/other bits.
# Back this file up — it's the only way to decrypt every per-target
# password and the Slack tokens.
MASTER_KEY_PATH=/etc/queryhub/master.key

LOG_LEVEL=INFO

# Optional: override the encrypted-secrets file path (default
# /etc/queryhub/secrets.enc).
# SECRETS_ENC_PATH=/etc/queryhub/secrets.enc

# Everything else — requester allowlist, display name/icon, query
# timeouts, CSV TTL, cost-saving knobs, set-allowed-params, etc. —
# lives in the `bot_config` table. Edit via SQL; see
# docs/OPERATIONS.md section 3 for the full list.


# ===========================================================================
# Container install only (docker-compose.install.yml). Uncomment these four.
#
# The systemd install leaves them commented: it keeps BOT_DB_PASSWORD in the
# encrypted secrets file instead, and an uncommented value here would quietly
# take precedence over it.
# ===========================================================================

# The metadata database password. In a container there is no encrypted secrets
# file to read it from, so it comes from the environment.
#BOT_DB_PASSWORD=

# The first admin account, created on first start and never touched again.
# Leave BOT_ADMIN's password empty and one is generated and printed once in
# `docker compose logs app`. Either way it is a bootstrap password: the account
# is created with "must change password", so it is good for exactly one login.
#QH_ADMIN_USER=admin
#QH_ADMIN_PASSWORD=

# The URL your users type. Used for links in notifications, and for the OIDC
# redirect if you enable Slack login. Set it before inviting anyone; leaving
# the loopback default means links point at their own machine.
#WEB_BASE_URL=http://localhost:8080

# Where to bind the published port. Loopback on purpose — put a reverse proxy
# in front for TLS rather than exposing this directly, and turn
# bot_config web_cookie_secure=on once you have https.
#QH_BIND=127.0.0.1:8080

# An image to run INSTEAD of building from this checkout. Leave it unset and the
# first `up` builds locally. To use a released image (or one you mirror
# yourself), `docker pull` it first so compose finds it locally, then set it
# here — e.g. QH_IMAGE=ghcr.io/ahmetrende/database-queryhub:1.0.0

# Uncomment to start a metadata Postgres alongside the app instead of using
# your own. Evaluation only — it puts the audit trail in a Docker volume.
# With it, also set BOT_DB_HOST=metadata-db above.
#COMPOSE_PROFILES=bundled-db
