[Unit]
Description=QueryHub — publish product-metrics dashboard to S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
Group=__USER__
WorkingDirectory=__INSTALL_PATH__
EnvironmentFile=/etc/queryhub/env
EnvironmentFile=-/etc/queryhub/dashboard.env
ExecStart=/usr/bin/env bash __INSTALL_PATH__/scripts/publish_metrics_dashboard.sh

# 2-minute hard cap. The build script's DB queries should finish in a
# few hundred ms; AWS S3 PUT for ~50KB completes in <1s; anything past
# 2 min is a network or service problem and worth alerting on.
TimeoutStartSec=120

# Keep logs visible in journalctl without spamming the parent (queryhub)
# service. systemd journal handles rotation.
StandardOutput=journal
StandardError=journal

# Hardening — same defaults the queryhub.service template uses.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__INSTALL_PATH__ /var/lib/queryhub
